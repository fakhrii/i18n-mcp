{
  "name": "i18n-mcp",
  "version": "0.1.2",
  "description": "Production-quality MCP server for automated internationalization across React Native, React (web), Next.js, and Flutter projects",
  "type": "module",
  "bin": {
    "i18n-mcp": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/mcp/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "i18n",
    "internationalization",
    "react-native",
    "react",
    "nextjs",
    "flutter",
    "dart",
    "i18next"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "vitest": "^3.0.8"
  }
}